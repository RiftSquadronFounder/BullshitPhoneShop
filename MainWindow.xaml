<Window x:Class="BullshitPhoneShop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Телефоны" Height="450" Width="800" MinHeight="300" MinWidth="460">
    <Window.Resources>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="5,0" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="70" />
        </Grid.RowDefinitions>

        <ListBox x:Name="mainListBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="9,7">
                        <TextBlock Text="{Binding Title}" FontSize="18" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Company}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Price}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Column="1" Grid.RowSpan="2" TextBlock.FontSize="14">
            <Label Content="_Модель" Target="{Binding ElementName=titleView}" Padding="0" />
            <TextBox x:Name="titleView" />
            <Label Content="_Производитель" Target="{Binding ElementName=companyView}" Padding="0" />
            <TextBox x:Name="companyView" />
            <Label Content="_Цена" Target="{Binding ElementName=priceView}" Padding="0" />
            <TextBox x:Name="priceView" />

            <UniformGrid x:Name="editActions" Columns="2" Margin="0,20,0,0" Visibility="Collapsed">
                <Button x:Name="cancelEditButton" Content="Отмена" HorizontalAlignment="Center"
                        Padding="4,0" Click="CancelEditButton_Click" />
                <Button x:Name="saveEditButton" Content="Сохранить" HorizontalAlignment="Center"
                        Padding="4,0" Click="SaveEditButton_Click" />
            </UniformGrid>
        </StackPanel>

        <StackPanel x:Name="phoneButtons" Grid.Row="1" Orientation="Horizontal">
            <Button x:Name="addButton" Style="{StaticResource IconButtonStyle}" Click="AddButton_Click"
                    AutomationProperties.Name="Добавить телефон" ToolTip="Добавить телефон">
                <Image Source="Images/add.png" Width="40" Height="40" />
            </Button>
            <Button x:Name="editButton" Style="{StaticResource IconButtonStyle}" Click="EditButton_Click"
                    AutomationProperties.Name="Редактировать телефон" ToolTip="Редактировать телефон">
                <Image Source="Images/edit.png" Width="40" Height="40" />
            </Button>
            <Button x:Name="removeButton" Style="{StaticResource IconButtonStyle}" Click="RemoveButton_Click"
                    AutomationProperties.Name="Удалить выбранный телефон" ToolTip="Удалить выбранный телефон">
                <Image Source="Images/delete.png" Width="40" Height="40" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
