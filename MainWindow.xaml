<Window x:Class="BullshitPhoneShop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Телефоны" Height="450" Width="800" MinHeight="300" MinWidth="460">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="70" />
        </Grid.RowDefinitions>

        <ListBox x:Name="mainListBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="9,7">
                        <TextBlock Text="{Binding Title}" FontSize="18" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Company}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Price}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Column="1" Grid.RowSpan="2" TextBlock.FontSize="14">
            <TextBlock Text="Выбранный элемент" />
            <Label Content="_Модель" Target="{Binding ElementName=titleView}" Padding="0" />
            <TextBox x:Name="titleView" />
            <Label Content="_Производитель" Target="{Binding ElementName=companyView}" Padding="0" />
            <TextBox x:Name="companyView" />
            <Label Content="_Цена" Target="{Binding ElementName=priceView}" Padding="0" />
            <TextBox x:Name="priceView" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Button Content="+" Width="40" Margin="5" Click="AddButton_Click"
                    AutomationProperties.Name="Добавить телефон" />
            <Button Content="-" Width="40" Margin="5" Click="RemoveButton_Click"
                    AutomationProperties.Name="Удалить выбранный телефон" />
        </StackPanel>
    </Grid>
</Window>
