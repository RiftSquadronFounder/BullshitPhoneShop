<Window x:Class="BullshitPhoneShop.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BullshitPhoneShop"
        Title="Редактирование" Width="585" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16,24,16,20">
        <TextBlock Text="Редактирование" FontSize="22" HorizontalAlignment="Left" Margin="54,0,0,28" />
        <local:PhoneForm x:Name="phoneForm" />
        <Button x:Name="submitButton" Content="Изменить" Width="172" Height="38" Margin="44,20,0,0"
                HorizontalAlignment="Left"
                IsDefault="True" Click="SaveEditButton_Click" />
    </StackPanel>
</Window>
