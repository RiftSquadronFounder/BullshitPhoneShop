<Window x:Class="BullshitPhoneShop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Телефоны" Height="520" Width="800" MinHeight="300" MinWidth="460"
        Loaded="MainWindow_Loaded">
    <Window.Resources>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="68" />
        </Grid.RowDefinitions>

        <DataGrid x:Name="mainDataGridView" Grid.Column="1" Margin="0,12,0,0"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  HeadersVisibility="Column" SelectionMode="Single" FontSize="16">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="56" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource IconButtonStyle}" Click="EditButton_Click"
                                        AutomationProperties.Name="Редактировать телефон" ToolTip="Редактировать телефон">
                                    <Image Source="Images/edit.png" Width="20" Height="20" />
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}" Click="RemoveButton_Click"
                                        AutomationProperties.Name="Удалить телефон" ToolTip="Удалить телефон">
                                    <Image Source="Images/delete.png" Width="20" Height="20" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="2*" MinWidth="110" />
                <DataGridTextColumn Header="Компания" Binding="{Binding CompanyEntity.Title}" Width="*" MinWidth="85" />
                <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="*" MinWidth="65" />
            </DataGrid.Columns>
        </DataGrid>

        <Button x:Name="addButton" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left"
                Width="48" Height="48" IsEnabled="False"
                Style="{StaticResource IconButtonStyle}" Click="AddButton_Click"
                AutomationProperties.Name="Добавить телефон" ToolTip="Добавить телефон">
            <Image Source="Images/add.png" Width="44" Height="44" />
        </Button>
    </Grid>
</Window>
